# macOS finder cruft
.DS_Store
# Custom-icon resource-fork marker (Finder's "paste image as icon")
Icon
Icon?

# Python bytecode
__pycache__/
*.pyc

# Server logs / temp state
/tmp/memorymap.pid

# Runtime data lives in ~/Library/Application Support/MemoryMap/ now.
# The on-disk data/ folder in this repo is legacy and intentionally untracked.
data/

# Session scratchpads (transcript probes, etc.)
.tmp_*.txt

# Local build artifacts (./build.sh output). CI uploads these to releases.
dist/

# Icon Composer scratch exports — regenerated each time you export from Icon
# Composer. The committed icon.icon/ is the source of truth.
icon Exports*/
